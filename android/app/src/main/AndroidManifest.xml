<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- GET /app-config -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="${primaryIcon}"
        android:roundIcon="${primaryRoundIcon}">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- NO LAUNCHER intent-filter here: launcher entries are the aliases below.
                 Deep link / push / share intent-filters stay on MainActivity. -->
        </activity>

        <!-- Launcher entries: one alias per name x icon, generated by Gradle
             placeholders so only the build's primary pair is enabled.
             Append-only: never rename or remove an alias. -->
        <activity-alias
            android:name=".AliasAuroraRocket"
            android:targetActivity=".MainActivity"
            android:enabled="${enabled_aurora_rocket}"
            android:exported="true"
            android:icon="@mipmap/ic_rocket"
            android:roundIcon="@mipmap/ic_rocket_round"
            android:label="@string/name_aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasAuroraStar"
            android:targetActivity=".MainActivity"
            android:enabled="${enabled_aurora_star}"
            android:exported="true"
            android:icon="@mipmap/ic_star"
            android:roundIcon="@mipmap/ic_star_round"
            android:label="@string/name_aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasAuroraHeart"
            android:targetActivity=".MainActivity"
            android:enabled="${enabled_aurora_heart}"
            android:exported="true"
            android:icon="@mipmap/ic_heart"
            android:roundIcon="@mipmap/ic_heart_round"
            android:label="@string/name_aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".AliasNovaRocket"
            android:targetActivity=".MainActivity"
            android:enabled="${enabled_nova_rocket}"
            android:exported="true"
            android:icon="@mipmap/ic_rocket"
